; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Rune Shift"
config/description="Forja hechizos combinando runas."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.055, 0.047, 0.09, 1)
config/icon="res://icon.svg"

[autoload]

Progression="*res://scripts/core/progression.gd"
Analytics="*res://scripts/systems/analytics.gd"
Ads="*res://scripts/systems/ad_service.gd"
Sfx="*res://scripts/systems/sfx.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/PixelifySans.ttf"
theme/default_font_antialiasing=0

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.055, 0.047, 0.09, 1)
